{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with study statistics and cloud sync preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user ID" },
        "displayName": { "type": "string", "description": "User display name" },
        "email": { "type": "string", "description": "User Google email" },
        "totalMastered": { "type": "number", "description": "Total words mastered" },
        "currentStreak": { "type": "number", "description": "Current active streak in days" },
        "preferredLanguage": { "type": "string", "description": "Preferred study language", "enum": ["all", "ja", "zh"] },
        "selectedSlot": { "type": "string", "description": "Active wallpaper theme slot" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["userId"]
    },
    "CustomPhrase": {
      "title": "CustomPhrase",
      "description": "Custom phrase authored by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique phrase ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "language": { "type": "string", "description": "Language code", "enum": ["ja", "zh"] },
        "nativeText": { "type": "string", "description": "Native characters (Kanji/Hanzi)" },
        "romanization": { "type": "string", "description": "Pronunciation" },
        "english": { "type": "string", "description": "English meaning" },
        "category": { "type": "string", "description": "Category name" },
        "culturalNote": { "type": "string", "description": "Optional usage note" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "userId", "language", "nativeText", "romanization", "english"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "Bookmarked favorite phrase reference",
      "type": "object",
      "properties": {
        "phraseId": { "type": "string", "description": "Phrase identifier" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "savedAt": { "type": "string", "format": "date-time", "description": "Bookmark timestamp" }
      },
      "required": ["phraseId", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile and synced settings"
    },
    "/users/{userId}/customPhrases/{phraseId}": {
      "schema": "CustomPhrase",
      "description": "Custom phrases created by the user"
    },
    "/users/{userId}/favorites/{phraseId}": {
      "schema": "Favorite",
      "description": "User bookmarked favorite phrases"
    }
  }
}
